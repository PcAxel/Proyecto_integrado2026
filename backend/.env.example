DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (DB_ENGINE=sqlite solo para pruebas locales sin servidor MySQL)
DB_ENGINE=mysql
DB_NAME=fyag_erp
DB_USER=fyag
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correo (en desarrollo se imprime en consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FYAG ERP <no-reply@fyag.cl>

# Link a la pantalla de instalación de la PWA
PWA_INSTALL_URL=http://localhost:5173/instalar

# MongoDB (evidencia fotográfica)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=fyag_evidencias

# Producción (DJANGO_DEBUG=False): HTTPS obligatorio, cookies Secure y HSTS se activan solos.
# DJANGO_ALLOWED_HOSTS=api.fyag.cl
# CORS_ALLOWED_ORIGINS=https://app.fyag.cl
# CSRF_TRUSTED_ORIGINS=https://app.fyag.cl
# DJANGO_PROXY_SSL=True            # si un balanceador termina TLS y envía X-Forwarded-Proto
# REFRESH_COOKIE_SAMESITE=Lax      # app y API deben compartir sitio (app.fyag.cl / api.fyag.cl)
# Correo REAL de bienvenida (sin esto se imprime en consola y no llega a nadie):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tu-proveedor.cl
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...

# Agente de IA (DeepSeek). La clave vive solo en el servidor.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Proxies/balanceadores propios delante de Django (0 = conexión directa). Si es 1 o más, se lee la IP real del cliente
# desde X-Forwarded-For; con un valor incorrecto la IP de la firma quedaría falsificable o sería la del proxy.
# PROXIES_DE_CONFIANZA=1
