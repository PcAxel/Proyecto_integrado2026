# Copia este archivo a `.env.prod` en el servidor (NUNCA se sube a git) y completa los valores.
# Contraseñas aleatorias:  openssl rand -hex 24      Clave de Django:  openssl rand -base64 50 | tr -d '\n'

# --- Dirección pública del backend (la usa Vercel y Caddy). Sin dominio propio: IP con guiones + .sslip.io
# Ejemplo: la IP 129.151.10.20 -> 129-151-10-20.sslip.io
API_HOST=129-151-10-20.sslip.io
ACME_EMAIL=tu-correo@ejemplo.com

# --- Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=129-151-10-20.sslip.io
# URL de tu app en Vercel (sin / final). Es lo único que puede usar la API desde un navegador.
CORS_ALLOWED_ORIGINS=https://TU-PROYECTO.vercel.app
CSRF_TRUSTED_ORIGINS=https://TU-PROYECTO.vercel.app
PWA_INSTALL_URL=https://TU-PROYECTO.vercel.app/instalar

# --- MySQL (usa solo letras y números en las contraseñas)
DB_NAME=fyag_erp
DB_USER=fyag
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- MongoDB (usa solo letras y números en la contraseña: va dentro de una URL)
MONGO_USER=fyag
MONGO_PASSWORD=
MONGO_DB_NAME=fyag_evidencias

# --- Correo: sin SMTP los correos de alta salen en el log del contenedor (docker compose logs backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Asistente de IA (opcional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Contraseña de las cuentas de demostración (comando seed_fyag). Si la dejas vacía se generan aleatorias y se muestran una vez.
FYAG_SEED_PASSWORD=
